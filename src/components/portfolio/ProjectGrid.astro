---
/**
 * Wiederverwendbare Portfolio-Komponente.
 *
 *   <ProjectGrid projekte={liste} lang="de" />                 → Raster mit Filter
 *   <ProjectGrid projekte={liste} lang="de" filter={false} />  → nur Raster (z. B. Startseite)
 *
 * Neue Projekte erscheinen automatisch, sobald eine Datei in src/content/projekte/ liegt.
 */
import ProjectCard from './ProjectCard.astro';
import { genutzteKategorien, type Projekt } from '../../lib/projekte';
import { useT, type Lang } from '../../i18n/ui';

interface Props {
  projekte: Projekt[];
  lang: Lang;
  filter?: boolean;
  /** Jede wievielte Kachel doppelt so groß dargestellt wird (0 = nie). */
  akzentAlle?: number;
  /** Überschriftenebene der Kacheltitel, passend zur Seite (2 oder 3). */
  stufe?: 2 | 3;
}
const { projekte, lang, filter = true, akzentAlle = 5, stufe = 3 } = Astro.props;
const t = useT(lang);
const kategorien = genutzteKategorien(projekte);
---

<div class="portfolio" data-portfolio>
  {
    filter && kategorien.length > 1 && (
      <div class="filter" role="group" aria-label={t('filter.label')}>
        <button type="button" class="chip" data-filter="alle" aria-pressed="true">
          {t('filter.alle')}
        </button>
        {kategorien.map((k) => (
          <button type="button" class="chip" data-filter={k} aria-pressed="false">
            {t(`kat.${k}`)}
          </button>
        ))}
        <p class="count" aria-live="polite" data-count data-eins={t('filter.anzahl')(1)} data-viele={t('filter.anzahl')(99)}>
          {t('filter.anzahl')(projekte.length)}
        </p>
      </div>
    )
  }

  <ul class="grid" data-grid>
    {
      projekte.map((p, i) => (
        <ProjectCard projekt={p} lang={lang} stufe={stufe} eager={i < 2} gross={akzentAlle > 0 && i % akzentAlle === 0} />
      ))
    }
  </ul>
</div>

<script>
  import { initPortfolio } from '../../scripts/portfolio';
  document.querySelectorAll<HTMLElement>('[data-portfolio]').forEach(initPortfolio);
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .chip {
    min-height: 2.5rem;
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .chip:hover {
    color: var(--text);
    border-color: var(--muted);
  }
  .chip[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .count {
    margin: 0 0 0 auto;
    font-size: var(--fs-meta);
    color: var(--muted);
  }
  @media (max-width: 699px) {
    /* Auf dem Handy: Filter als wischbare Zeile */
    .filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .filter::-webkit-scrollbar {
      display: none;
    }
    .chip {
      flex: none;
    }
    .count {
      display: none;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid > :global(.card--gross) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid > :global(.card--gross) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .grid > :global(.card--gross .card__media) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 100%;
    }
    .grid > :global(.card--gross .card__link) {
      height: 100%;
    }
  }
  .grid {
    grid-auto-flow: dense;
  }
  .portfolio:global(.is-filtered) .grid > :global(.card--gross) {
    grid-column: auto;
    grid-row: auto;
  }
  .portfolio:global(.is-filtered) .grid > :global(.card--gross .card__media) {
    aspect-ratio: 16 / 9;
    height: auto;
    min-height: 0;
  }
  /* Ein- und Ausblenden beim Filtern */
  .grid > :global(.card.is-entering) {
    animation: card-in 0.5s var(--ease) both;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
