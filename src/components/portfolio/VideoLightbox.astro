---
/**
 * Eine Lightbox für alle Filme der Seite. Jedes Element mit data-lightbox öffnet sie:
 *
 *   <button data-lightbox data-video-src="/media/x/film.mp4" data-video-src-mobil="/media/x/film-720.mp4"
 *           data-poster="/…jpg" data-title="Titel">Abspielen</button>
 *   <button data-lightbox data-youtube="VIDEO_ID" data-title="Titel">Abspielen</button>
 *
 * Der Film wird erst beim Öffnen geladen und beim Schließen wieder freigegeben.
 */
import { useT, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
---

<dialog class="lb" data-lb aria-label="Video" data-yt-hinweis={t('player.yt.hinweis')} data-yt-laden={t('player.yt.laden')}>
  <button class="lb__close" type="button" data-lb-close>
    <span class="visually-hidden">{t('player.schliessen')}</span>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>
  <div class="lb__stage" data-lb-stage></div>
  <div class="lb__loader" aria-hidden="true"><span></span></div>
  <p class="visually-hidden" aria-live="polite" data-lb-status data-text={t('player.laden')}></p>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: var(--text);
    overflow: hidden;
  }
  .lb::backdrop {
    background: #000;
  }
  .lb[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.45s var(--ease);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb__stage {
    width: min(100vw, calc((100dvh - 7rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    position: relative;
    z-index: 1;
  }
  .lb.is-hochkant .lb__stage {
    width: min(100vw, calc((100dvh - 7rem) * 9 / 16));
    aspect-ratio: 9 / 16;
  }
  .lb__stage :global(video),
  .lb__stage :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .lb.is-ready .lb__stage :global(video),
  .lb.is-ready .lb__stage :global(iframe) {
    opacity: 1;
  }
  .lb__close {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    z-index: 3;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(0 0 0 / 0.4);
    color: #fff;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.3s var(--ease);
  }
  .lb__close:hover {
    border-color: #fff;
    transform: rotate(90deg);
  }
  .lb__loader {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .lb.is-ready .lb__loader {
    opacity: 0;
  }
  .lb__loader span {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.15);
    border-top-color: #fff;
    animation: lb-spin 0.9s linear infinite;
  }
  @keyframes lb-spin {
    to {
      transform: rotate(1turn);
    }
  }
  .lb__stage :global(.lb__consent) {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
    max-width: 36rem;
    margin: auto;
    color: var(--muted);
  }
</style>
