---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoLightbox from '../components/portfolio/VideoLightbox.astro';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pfad derselben Seite in der anderen Sprache (für Umschalter und hreflang). */
  alternate: { de: string; en: string };
  /** Ein großes Bild, das sofort geladen werden soll (z. B. Hero-Poster). */
  preloadImage?: { src: string; type: string };
  transparentHeader?: boolean;
}
const { lang, title, description, alternate, preloadImage, transparentHeader = false } = Astro.props;
const t = useT(lang);
const site = Astro.site!;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <link rel="alternate" hreflang="de" href={new URL(alternate.de, site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternate.en, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternate.de, site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} type={preloadImage.type} fetchpriority="high" />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip" href="#inhalt">{t('nav.skip')}</a>
    <Header lang={lang} alternate={alternate} transparent={transparentHeader} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer lang={lang} />
    <VideoLightbox lang={lang} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--text);
    color: var(--bg);
    padding: 0.6rem 1rem;
    border-radius: 999px;
    transition: top 0.2s;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
