# Bildmechaniker – Serverkonfiguration für Host Europe (Apache)

# HTTPS und www erzwingen
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.bildmechaniker.de%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^bildmechaniker\.de$ [NC]
RewriteRule ^ https://www.bildmechaniker.de%{REQUEST_URI} [L,R=301]

# Startseite: englischsprachige Browser nach /en/, alle anderen nach /de/
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteRule ^$ /en/ [L,R=302]
RewriteRule ^$ /de/ [L,R=302]

# Passende Dateitypen
AddType video/mp4 .mp4
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2

# Komprimierung für Text
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Caching: Astro versieht Bilder, CSS und JS mit Fingerabdruck → ein Jahr cachen.
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.mp4$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html
