# Nur anfrage.php und optionen.json sind von außen erreichbar.
<FilesMatch "\.(php|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(anfrage\.php|optionen\.json)$">
  Require all granted
</FilesMatch>
Options -Indexes

# Uploads bis 20 MB zulassen (falls der Tarif .htaccess-PHP-Werte erlaubt)
<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 24M
  php_value max_file_uploads 6
</IfModule>
